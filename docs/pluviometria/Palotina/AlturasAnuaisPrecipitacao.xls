<script type="text/javascript">
	function gerarRelatorio(){
		var form = document.gerarRelatorioAlturasMensaisPrecipitacaoForm;
		
		form.action = "gerarRelatorioAlturasAnuaisPrecipitacao.do?action=gerarRelatorio";
		limparMensagem();
		if (validarForm()){
			form.submit();
		}
	}

	function validarForm(){
		if(!verificarAno()){
			exibirMensagemAviso("Ano inválido.");
			return false;
		}

		if(verificarMunicipio() && verificarEstacao()){
			exibirMensagemAviso("Escolha um município ou coloque um código válido para a estação.")
			return false;
		}
		return true;
	}

	function carregarNomeEstacao(codEstacao) {
		var form = document.gerarRelatorioAlturasMensaisPrecipitacaoForm;

		//if(form.codEstacao.value != "") {
			submitAjax("gerarRelatorioAlturasAnuaisPrecipitacao.do?action=carregarNomeEstacaoAjax&codEstacao="
						+ codEstacao, document.forms[0], "divNomeEstacao", true, false);
		//}

		desabilitarMunicipio();
		

	}

	function desabilitarMunicipio() {
		var form = document.gerarRelatorioAlturasMensaisPrecipitacaoForm;
		if(!verificarMunicipio() && verificarEstacao()) {
			form.codMunicipio.disabled = true;
			form.codMunicipio.select = 0;
		}  else {
			form.codMunicipio.disabled = false;
		}
	}

	function desabilitarEstacao() {
		var form = document.gerarRelatorioAlturasMensaisPrecipitacaoForm;
		if(!verificarEstacao() && verificarMunicipio()) {
			form.codEstacao.disabled = true;
			form.codEstacao.value = "";
		}  else {
			form.codEstacao.disabled = false;
		}
	}

	function voltar() {
		window.location = "loginUsuario.do?action=carregarInterfaceInicial";
	}
	
	function limpar() {
		window.location = "gerarRelatorioAlturasAnuaisPrecipitacao.do?action=iniciar";
	} 

	function verificarEstacao() {
		return document.forms[0].codMunicipio.value == "";
	}

	function verificarMunicipio() {
		return (document.forms[0].codEstacao.value == "") && (document.forms[0].nomeEstacao.value == "");
	}

	function verificarAno(){
		var form = document.gerarRelatorioAlturasMensaisPrecipitacaoForm;

		if(form.anoInicial.value == "" || form.anoInicial.value > form.anoAtual.value || 
				form.anoFinal.value == "" || form.anoFinal.value > form.anoAtual.value){
			return false; 
		}
		return true;
	}

</script>



