	<script type="text/javascript">
		function abrirJanela(url) {
			var screenX = (window.screen.width - 800) / 2;
			var screenY = (window.screen.height - 600) / 2;
			window.open(url, "default", "width=800, height=600, top=" + screenY + ", left=" + screenX + ", status=yes, scrollbars=yes");
		}
